    </Reference>
    <Reference Include="System.Drawing.Primitives">
      <HintPath>..\..\..\..\Program Files\dotnet\shared\Microsoft.NETCore.App\8.0.32\System.Drawing.Primitives.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms.Primitives">
      <HintPath>..\..\..\..\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\8.0.32\System.Windows.Forms.Primitives.dll</HintPath>
